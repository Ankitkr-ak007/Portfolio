{
  "name": "portfolio",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint",
    "test": "vitest run",
    "test:unit": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:lighthouse": "lhci autorun",
    "preview": "vite preview",
    "ai:sync": "node scripts/ai/sync-context.mjs",
    "ai:sync:full": "node scripts/ai/sync-context.mjs --full",
    "ai:start": "node scripts/ai/session-start.mjs",
    "ai:state": "node scripts/ai/state.mjs",
    "ai:health": "node scripts/ai/health.mjs",
    "ai:repair": "node scripts/ai/repair.mjs",
    "ai:rebuild": "node scripts/ai/rebuild.mjs",
    "ai:rebuild-history": "node scripts/ai/rebuild-history.mjs",
    "ai:changes": "node scripts/ai/analyze-changes.mjs",
    "ai:diff": "node scripts/ai/diff.mjs",
    "ai:history": "node scripts/ai/history.mjs",
    "ai:record": "node scripts/ai/record.mjs",
    "ai:gaps": "node scripts/ai/detect-gaps.mjs",
    "ai:install-hooks": "node scripts/ai/install-hooks.mjs",
    "ai:hooks:status": "node scripts/ai/hooks-status.mjs",
    "ai:notes:push": "node scripts/ai/notes-push.mjs",
    "ai:notes:fetch": "node scripts/ai/notes-fetch.mjs",
    "ai:end": "node scripts/ai/session-end.mjs",
    "ai:validate": "node scripts/ai/validate-context.mjs",
    "ai:git": "node scripts/ai/analyze-git.mjs",
    "ai:inspect": "node scripts/ai/inspect.mjs"
  },
  "dependencies": {
    "@react-three/drei": "^10.7.8",
    "@react-three/fiber": "^9.7.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/canvas-confetti": "^1.9.0",
    "@types/three": "^0.186.0",
    "canvas-confetti": "^1.9.4",
    "clsx": "^2.1.1",
    "lenis": "^1.3.26",
    "lucide-react": "^1.46.0",
    "motion": "^13.4.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "three": "^0.186.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@lhci/cli": "^0.15.1",
    "@playwright/test": "^1.63.0",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "jsdom": "^30.1.0",
    "oxlint": "^1.81.0",
    "typescript": "~6.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.1"
  }
}
